# ===== 数据库后端（spec 强制 PostgreSQL；默认 SQLite 便于本地开发/测试）=====
# 不设 DATABASE_URL → 各服务用本地 SQLite（默认路径见各服务 *_DATA_DIR）。
# 设为 postgres://... → knowledge-api / rca-agent / agent-platform 自动切换到
# PostgreSQL（PgKnowledgeStore / PgRcaStore / PgAgentRunStore），并依赖 OpenSearch
# 提供 BM25（spec §5.4）；首次启动前需跑迁移：
#   MIGRATION_DATABASE_URL=$DATABASE_URL alembic upgrade head
DATABASE_URL=
# 示例：DATABASE_URL=postgres://ai_employee:ai_employee@localhost:5432/ai_employee

# ===== knowledge-api =====
KNOWLEDGE_DATA_DIR=./var/data
KNOWLEDGE_SQLITE_PATH=./var/data/knowledge.sqlite3
INGESTION_WORKER_URL=http://127.0.0.1:8001
INGESTION_WORKER_TIMEOUT_S=30
KNOWLEDGE_API_INTERNAL_TOKEN=change-me
MAX_UPLOAD_BYTES=10485760

# ===== ingestion-worker / RAG 文档解析（spec §5.2 §5.3）=====
# 扫描件 OCR 后端：disabled（默认，无依赖）/ qwen_vl_ocr（阿里云百炼 qwen-vl-ocr 专用 OCR VLM，需 QWEN_API_KEY 或 DASHSCOPE_API_KEY，推荐）/ rapidocr（rapidocr_onnxruntime，CPU）/ tesseract（系统二进制）
OCR_BACKEND=disabled
# 阿里云百炼 OpenAI 兼容端点（qwen-vl-ocr 默认走这里）
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QwenVlOcrBackend 模型 id（专用 OCR 模型 qwen-vl-ocr 不传提示词；通用 VLM 如 qwen-vl-max 会自动加 OCR 提示）
# QWEN_VL_OCR_MODEL=qwen-vl-ocr
# 也可指向 SiliconFlow 托管的 Qwen-VL（设 SILICONFLOW_BASE_URL + QWEN_VL_OCR_MODEL=Qwen/Qwen2.5-VL-72B-Instruct）
# 超长块分段策略：sliding（默认，滑动窗口重叠）/ boundary（句号硬切无重叠）
CHUNK_STRATEGY=sliding
CHUNK_WINDOW_SIZE=800
CHUNK_OVERLAP=80

# ===== ingestion-worker / 查询侧 embedding（两个服务共享同一配置）=====
# provider: stub / qwen / openai_compat / siliconflow
EMBEDDING_PROVIDER=stub
# 向量维度（stub 默认 8；qwen 默认 1024）
EMBEDDING_DIM=8

# ----- qwen（阿里云 DashScope，OpenAI-compatible）-----
# 推荐 text-embedding-v3 @ 1024 维；v4 为升级路径。批量上限 10/请求，内部自动分批。
QWEN_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ----- siliconflow（硅基流动，BAAI/bge-m3 默认 1024-dim，spec §5.4 推荐）-----
# 设置 SILICONFLOW_API_KEY 即可启用；同时知识库两阶段 rerank 自动启用 BGE
# reranker-v2-m3，无需额外配置。模型可被 SILICONFLOW_<TASK>_MODEL 覆盖。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ----- openai_compat（通用 OpenAI-compatible 接口）-----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== R21 service isolation (spec §9) =====
# agent-platform can delegate approval tasks + tool state to standalone
# services.  When the URL is set, the platform uses the HTTP client;
# when unset, it falls back to the in-memory store (backward compat
# / local dev / tests).

# Standalone approval-service (R21): owns the approval task state
# machine + governance (supplement / transfer / escalation).
# APPROVAL_SERVICE_URL=http://approval-service:8040

# Standalone mcp-gateway (R21): unified tool register / discover /
# invoke with circuit breaker.
# MCP_GATEWAY_URL=http://mcp-gateway:8050

# Shared internal token for cross-service calls (HttpApprovalServiceClient,
# HttpMcpGatewayClient send ``X-Internal-Token`` when set).
INTERNAL_TOKEN=change-me
