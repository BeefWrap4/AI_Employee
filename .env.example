# ===== knowledge-api =====
KNOWLEDGE_DATA_DIR=./var/data
KNOWLEDGE_SQLITE_PATH=./var/data/knowledge.sqlite3
INGESTION_WORKER_URL=http://127.0.0.1:8001
INGESTION_WORKER_TIMEOUT_S=30
KNOWLEDGE_API_INTERNAL_TOKEN=change-me
MAX_UPLOAD_BYTES=10485760

# ===== ingestion-worker / 查询侧 embedding（两个服务共享同一配置）=====
# provider: stub / qwen / openai_compat / siliconflow
EMBEDDING_PROVIDER=stub
# 向量维度（stub 默认 8；qwen 默认 1024）
EMBEDDING_DIM=8

# ----- qwen（阿里云 DashScope，OpenAI-compatible）-----
# 推荐 text-embedding-v3 @ 1024 维；v4 为升级路径。批量上限 10/请求，内部自动分批。
QWEN_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ----- siliconflow（硅基流动，BAAI/bge-m3 默认 1024-dim，spec §5.4 推荐）-----
# 设置 SILICONFLOW_API_KEY 即可启用；同时知识库两阶段 rerank 自动启用 BGE
# reranker-v2-m3，无需额外配置。模型可被 SILICONFLOW_<TASK>_MODEL 覆盖。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
# SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ----- openai_compat（通用 OpenAI-compatible 接口）-----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
